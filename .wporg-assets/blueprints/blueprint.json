{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Blockshifter demo",
		"description": "Native Gallery and Query Loop blocks shifted into a Carousel and a Masonry grid.",
		"author": "nighcrawl",
		"categories": [
			"Blocks",
			"Gallery"
		]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "blockshifter"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire_once '/wordpress/wp-load.php';\nwp_set_current_user( 1 ); // Admin: keeps block markup out of kses.\n\nwp_delete_post( 1, true ); // \"Hello world!\"\nwp_delete_post( 2, true ); // \"Sample Page\"\n\n$posts = array(\n\tarray( 'Shipping a carousel without a slider plugin', 'A Query Loop is already a list of posts. Blockshifter just changes its shape on the front end.' ),\n\tarray( 'Why native blocks age better', 'Content stored as core blocks survives theme switches, plugin changes and editor redesigns.' ),\n\tarray( 'Masonry with CSS Grid only', 'No layout library: Blockshifter computes each tile span and lets CSS Grid do the rest.' ),\n\tarray( 'One toggle, no new workflow', 'Select the block, open its Inspector, flip the switch. That is the whole learning curve.' ),\n\tarray( 'Assets load only where used', 'Carousel and Masonry scripts are enqueued only on pages where a block is actually shifted.' ),\n\tarray( 'Deactivate without breaking anything', 'Turn Blockshifter off and your blocks fall back to a regular Gallery, Group or post list.' ),\n);\nforeach ( $posts as $i => $post ) {\n\twp_insert_post( array(\n\t\t'post_title'   => $post[0],\n\t\t'post_excerpt' => $post[1],\n\t\t'post_content' => '<!-- wp:paragraph --><p>' . esc_html( $post[1] ) . '</p><!-- /wp:paragraph -->',\n\t\t'post_status'  => 'publish',\n\t\t'post_date'    => gmdate( 'Y-m-d H:i:s', time() - ( $i + 1 ) * DAY_IN_SECONDS ),\n\t) );\n}\n\n$page_id = wp_insert_post( array(\n\t'post_type'    => 'page',\n\t'post_title'   => 'Blockshifter demo',\n\t'post_status'  => 'publish',\n\t'post_content' => <<<'DEMO'\n<!-- wp:paragraph -->\n<p>Every block on this page is a <strong>native</strong> WordPress block: two Gallery blocks and a Query Loop. Blockshifter only changes how they look on the front end. Click <strong>Edit Page</strong> in the toolbar above, select a block, and open the <strong>Blockshifter</strong> panels in the sidebar: one toggle turns it on or off.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">A Gallery block, shifted into a Carousel</h2>\n<!-- /wp:heading -->\n\n<!-- wp:gallery {\"linkTo\":\"none\",\"blockshifterTransform\":\"carousel\",\"blockshifterConfig\":{\"carousel\":{\"perPage\":2,\"autoplay\":true,\"loop\":true}}} -->\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1018/1200/800\" alt=\"Mountain valley\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1015/1200/800\" alt=\"River between cliffs\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1039/1200/800\" alt=\"Waterfall in a forest\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1043/1200/800\" alt=\"Lake at dusk\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1067/1200/800\" alt=\"City skyline\"/></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">A Gallery block, shifted into a Masonry grid</h2>\n<!-- /wp:heading -->\n\n<!-- wp:gallery {\"columns\":3,\"imageCrop\":false,\"linkTo\":\"none\",\"blockshifterTransform\":\"masonry\"} -->\n<figure class=\"wp-block-gallery has-nested-images columns-3\"><!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1025/800/1100\" alt=\"Dog wrapped in a blanket\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1035/800/533\" alt=\"Waterfall\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1040/800/800\" alt=\"Castle on a hill\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1050/800/533\" alt=\"Sea cliffs\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1062/800/1200\" alt=\"Dog under a blanket\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1074/800/600\" alt=\"Lioness\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1080/800/1000\" alt=\"Strawberries\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:image {\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://picsum.photos/id/1084/800/533\" alt=\"Walrus\"/></figure>\n<!-- /wp:image --></figure>\n<!-- /wp:gallery -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">A Query Loop, shifted into a Carousel of your latest posts</h2>\n<!-- /wp:heading -->\n\n<!-- wp:query {\"queryId\":1,\"query\":{\"perPage\":6,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"author\":\"\",\"search\":\"\",\"exclude\":[],\"sticky\":\"\",\"inherit\":false}} -->\n<div class=\"wp-block-query\"><!-- wp:post-template {\"blockshifterTransform\":\"carousel\",\"blockshifterConfig\":{\"carousel\":{\"perPage\":3,\"loop\":true}}} -->\n<!-- wp:post-title {\"isLink\":true} /-->\n\n<!-- wp:post-date /-->\n\n<!-- wp:post-excerpt /-->\n<!-- /wp:post-template --></div>\n<!-- /wp:query -->\n\n<!-- wp:paragraph -->\n<p>Deactivate Blockshifter and nothing breaks: these blocks simply go back to a regular Gallery and a regular post list.</p>\n<!-- /wp:paragraph -->\nDEMO,\n) );\n\nupdate_option( 'show_on_front', 'page' );\nupdate_option( 'page_on_front', $page_id );\n\n// Skip the block editor welcome guide so \"Edit Page\" lands straight on the blocks.\nupdate_user_meta( 1, $GLOBALS['wpdb']->get_blog_prefix() . 'persisted_preferences', array(\n\t'core/edit-post' => array( 'welcomeGuide' => false ),\n\t'core'           => array( 'isComplementaryAreaVisible' => true ),\n\t'_modified'      => gmdate( 'c' ),\n) );\n"
		}
	]
}
