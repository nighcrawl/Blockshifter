{
    "name": "blockshifter/blockshifter",
    "description": "Transform native Gutenberg blocks into alternate display variants without leaving the editor.",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Blockshifter\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-setup": "wp core download --path=.wp-core-src --version=6.7 --skip-content --force"
    }
}
